            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Try to create two students with the same email.\nNote: First run 'POST Create Student' to create the first one, then run this.\nExpected: 409 Conflict\n{\n  \"status\": 409,\n  \"error\": \"Conflict\",\n  \"message\": \"A student with email '...' already exists.\"\n}"
          },
          "event": [
